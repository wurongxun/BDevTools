{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDevTools",
  "version": "1.6.1",
  "identifier": "com.backend-development-tools.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**",
            "$AUDIO/**",
            "$CACHE/**",
            "$CONFIG/**",
            "$DATA/**",
            "$LOCALDATA/**",
            "$DESKTOP/**",
            "$DOCUMENT/**",
            "$DOWNLOAD/**",
            "$EXE/**",
            "$FONT/**",
            "$HOME/**",
            "$PICTURE/**",
            "$PUBLIC/**",
            "$RUNTIME/**",
            "$TEMPLATE/**",
            "$VIDEO/**",
            "$RESOURCE/**",
            "$APP/**",
            "$LOG/**",
            "$TEMP/**",
            "$APPCONFIG/**",
            "$APPDATA/**",
            "$APPLOCALDATA/**",
            "$APPCACHE/**",
            "$APPLOG/**"
          ]
        }
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb","nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md"],
        "mimeType": "text/markdown",
        "description": "Markdown"
      },{
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "txt"
      },{
        "ext": ["log"],
        "mimeType": "text/x-log",
        "description": "log"
      },{
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "description": "log"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNTkyQjZEMTY2MjUwRkMKUldUOFVHSVdiU3RaUTlCVHgzRHBRaXloRVp5NGV5aFlCd3N1WWtBZGdwcTdkcStKVXRPRDlObkUK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://gitee.com/wurongxun/BackendDevTools/blob/BDevTools/latest.json"]
    }
  }
}
