{
  "id": "text-toolkit",
  "name": "文本工具箱（WASM 示例）",
  "version": "1.0.0",
  "description": "示例第三方插件：页面只做展示，逻辑跑在 Extism WASM 沙箱里，演示 log / kv / fs / net 四类宿主能力的授权与拒绝",
  "icon": "Notebook",
  "entry": "page.html",
  "wasm": "plugin.wasm",
  "init": "init",
  "permissions": [
    "log",
    "kv",
    "fs:read",
    "fs:write",
    "net:api.github.com"
  ]
}
