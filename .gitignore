# Logs
# 注意：此处只忽略仓库根目录的 logs/ 输出目录。
# 早期写法 `logs` 会连带忽略 src/plugins/logs/ 插件源码，导致插件不入库。
/logs/
!src/plugins/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.tmp-build-*
~
*.local
/target/
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


/.qoder/
/.qoder/
