# Logs
# 注意：此处只忽略仓库根目录的 logs/ 输出目录。
# 早期写法 `logs` 会连带忽略 src/plugins/logs/ 插件源码，导致插件不入库。
/logs/
!src/plugins/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.tmp-build-*
# 仓库根的临时文件/目录（构建验证目录、verify.sh 给链接器用的临时目录等）
/.tmp-*
~
*.local
/target/
# 示例第三方插件：源码在 _guest/<name>/，只把编好的 .wasm 复制进包目录（见 examples/README.md）
/examples/third-party-plugins/_guest/*/target/
# plugin_wasm 的端到端冒烟测试会在 src-tauri/ 下创建插件私有数据目录
/src-tauri/plugin_data_ext/
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


